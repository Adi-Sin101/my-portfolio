        private void LoadProjects()
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                try
                {
                    con.Open();
                    string query = "SELECT Id, Title, Description, ImagePath, TechUsed, GitUrl FROM Projects ORDER BY CreatedDate DESC";
                    SqlDataAdapter da = new SqlDataAdapter(query, con);
                    DataTable dt = new DataTable();
                    da.Fill(dt);
                    
                    rptProjects.DataSource = dt;
                    rptProjects.DataBind();
                }
                catch (Exception ex)
                {
                    // Handle error - projects table might not exist
                    rptProjects.DataSource = GetDefaultProjects();
                    rptProjects.DataBind();
                }
            }
        }

