        private void LoadPersonalInfo()
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                try
                {
                    con.Open();
                    string query = "SELECT * FROM PersonalInfo WHERE IsActive = 1";
                    SqlCommand cmd = new SqlCommand(query, con);
                    SqlDataReader reader = cmd.ExecuteReader();
                    
                    if (reader.Read())
                    {
                        ltlName.Text = reader["FullName"].ToString();
                        ltlNavName.Text = reader["FullName"].ToString();
                        ltlHeroName.Text = reader["FullName"].ToString();
                        ltlRole.Text = reader["Role"].ToString();
                        ltlHeroDescription.Text = reader["HeroDescription"].ToString();
                        ltlAboutDescription.Text = reader["AboutDescription"].ToString();

                        // Social links
                        hlnkGitHub.NavigateUrl = reader["GitHubUrl"].ToString();
                        hlnkLinkedIn.NavigateUrl = reader["LinkedInUrl"].ToString();
                        hlnkEmail.NavigateUrl = "mailto:" + reader["Email"].ToString();
                        hlnkPhone.NavigateUrl = "tel:" + reader["Phone"].ToString();
                        hlnkResume.NavigateUrl = reader["ResumeUrl"].ToString();

                        // Contact section
                        hlnkContactEmail.Text = reader["Email"].ToString();
                        hlnkContactEmail.NavigateUrl = "mailto:" + reader["Email"].ToString();
                        hlnkContactLinkedIn.Text = reader["LinkedInText"].ToString();
                        hlnkContactLinkedIn.NavigateUrl = reader["LinkedInUrl"].ToString();
                        hlnkContactGitHub.Text = reader["GitHubText"].ToString();
                        hlnkContactGitHub.NavigateUrl = reader["GitHubUrl"].ToString();
                        hlnkContactPhone.Text = reader["Phone"].ToString();
                        hlnkContactPhone.NavigateUrl = "tel:" + reader["Phone"].ToString();

                        // Profile image
                        if (!string.IsNullOrEmpty(reader["ProfileImagePath"].ToString()))
                        {
                            imgHero.ImageUrl = reader["ProfileImagePath"].ToString();
                        }
                    }
                    reader.Close();
                }
                catch (Exception ex)
                {
                    // Set default values if PersonalInfo table doesn't exist
                    SetDefaultPersonalInfo();
                }
            }
        }

